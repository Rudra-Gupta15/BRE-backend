# Copy to .env and fill in your values. No URL-encoding needed for the PG
# password / db name — put the '@' and spaces in as-is.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
INVENTORY_PG_HOST=
INVENTORY_PG_PORT=5432
INVENTORY_PG_USER=postgres
INVENTORY_PG_PASSWORD=
INVENTORY_PG_DATABASE=
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db   # full URL wins if set

# Bank-statement vision LLM (Ollama). qwen2.5vl:3b = fully local; gemma4:31b-cloud = Ollama Cloud.
OLLAMA_HOST=http://localhost:11434
STATEMENT_LLM_MODEL=gemma4:31b-cloud
STATEMENT_LLM_TIMEOUT=120
STATEMENT_LLM_DPI=150
STATEMENT_PARSER_VERSION=2026.08-vision

# ML-security guardrails (defaults shown; 0 disables an upload check)
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=60
MAX_TRANSACTIONS=5000
ALLOWED_UPLOAD_EXT=pdf,csv,tsv,txt
MODEL_PROMOTE_MAX_REGRESSION=0.03
DRIFT_PSI_WARN=0.10
DRIFT_PSI_ALERT=0.25
# HMAC key for signing model artifacts. Leave blank to auto-generate models/.signing_key
MODEL_SIGNING_KEY=
